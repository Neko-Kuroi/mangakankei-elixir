<main class="max-w-4xl mx-auto my-7 bg-white p-7 rounded-lg shadow">
  <PlatformExWeb.Layouts.flash_group flash={@flash} />
  <h2 class="text-lg font-semibold mb-5">🔐 アカウント管理</h2>

  <%= if @current_user do %>
    <p class="mb-4">
      👤 {@current_user.username} としてログイン中
      <span class="text-slate-500 text-sm">
        （{if @current_user.account_type == "reader", do: "読者", else: "作者"}
        <%= if PlatformEx.Admin.admin?(@current_user.username) do %>
          ・管理者
        <% end %>）
      </span>
    </p>
    <form action="/session/logout" method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <button
        type="submit"
        class="bg-slate-600 text-white px-4 py-2 rounded text-sm font-semibold"
      >
        ログアウト
      </button>
    </form>
  <% else %>
    <div class="grid md:grid-cols-2 gap-8">
      <section>
        <h3 class="font-semibold mb-3">ログイン</h3>
        <form action="/session" method="post" class="space-y-3">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label class="block text-sm font-semibold mb-1">ユーザー名</label>
            <input
              type="text"
              name="username"
              required
              class="w-full border rounded px-2.5 py-2 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">パスワード</label>
            <input
              type="password"
              name="password"
              required
              class="w-full border rounded px-2.5 py-2 text-sm"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 text-white px-4 py-2 rounded text-sm font-semibold"
          >
            ログインする
          </button>
        </form>
      </section>

      <section>
        <h3 class="font-semibold mb-3">新規アカウント作成</h3>
        <form action="/session/signup" method="post" class="space-y-3">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label class="block text-sm font-semibold mb-1">ユーザー名</label>
            <input
              type="text"
              name="username"
              required
              class="w-full border rounded px-2.5 py-2 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">メールアドレス</label>
            <input
              type="email"
              name="email"
              required
              class="w-full border rounded px-2.5 py-2 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">パスワード</label>
            <input
              type="password"
              name="password"
              required
              class="w-full border rounded px-2.5 py-2 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">アカウント種別</label>
            <select name="account_type" class="w-full border rounded px-2.5 py-2 text-sm">
              <option value="author">作者</option>
              <option value="reader">読者</option>
            </select>
          </div>
          <button
            type="submit"
            class="w-full bg-emerald-600 text-white px-4 py-2 rounded text-sm font-semibold"
          >
            アカウントを登録
          </button>
        </form>
      </section>
    </div>
  <% end %>
</main>
